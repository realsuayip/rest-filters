#: constraints.py:44
#, python-format
msgid "Request failed to meet constraint: %(constraint)s"
msgstr "Die Anfrage erfüllt die Einschränkung nicht: %(constraint)s"

#: constraints.py:88
#, python-format
msgid ""
"The following fields are mutually exclusive, you may only provide one of "
"them: %(fields)s"
msgstr ""
"Die folgenden Felder schließen sich gegenseitig aus; Sie dürfen nur eines "
"davon angeben: %(fields)s"

#: constraints.py:124
#, python-format
msgid ""
"The following fields are mutually inclusive, you must provide them all at "
"once or none of them: %(fields)s"
msgstr ""
"Die folgenden Felder sind gemeinsam erforderlich; Sie müssen sie entweder "
"alle zusammen angeben oder keines: %(fields)s"

#: constraints.py:160
#, python-format
msgid ""
"This query parameter also requires the following parameter to be present: "
"%(params)s"
msgid_plural ""
"This query parameter also requires the following parameters to be present: "
"%(params)s"
msgstr[0] ""
"Dieser Abfrageparameter erfordert außerdem, dass der folgende Parameter "
"vorhanden ist: %(params)s"
msgstr[1] ""
"Dieser Abfrageparameter erfordert außerdem, dass die folgenden Parameter "
"vorhanden sind: %(params)s"

#: fields.py:100
msgid "Enter a valid CSV value."
msgstr "Geben Sie einen gültigen CSV-Wert ein."

#: fields.py:129 fields.py:165
#, python-brace-format
msgid "{input} is not a valid choice, available choices are: {choices}"
msgstr ""
"{input} ist keine gültige Auswahl. Verfügbare Auswahlmöglichkeiten: {choices}"

#: filters.py:372
msgid "This query parameter does not allow specifying multiple values."
msgstr ""
"Für diesen Abfrageparameter können nicht mehrere Werte angegeben werden."

#: filtersets/base.py:512
msgid "This query parameter does not exist."
msgstr "Dieser Abfrageparameter existiert nicht."

#: filtersets/base.py:516
#, python-format
msgid "This query parameter does not exist. Did you mean '%(param)s'?"
msgstr "Dieser Abfrageparameter existiert nicht. Meinten Sie '%(param)s'?"

#: filtersets/base.py:524
#, python-format
msgid ""
"This query parameter does not exist. Did you mean one of these: "
"%(possibilities)s?"
msgstr ""
"Dieser Abfrageparameter existiert nicht. Meinten Sie eine der folgenden "
"Möglichkeiten: %(possibilities)s?"
