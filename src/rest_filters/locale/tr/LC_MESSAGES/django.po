#: constraints.py:44
#, python-format
msgid "Request failed to meet constraint: %(constraint)s"
msgstr "İstek şu kısıtlamayı karşılamadı: %(constraint)s"

#: constraints.py:88
#, python-format
msgid ""
"The following fields are mutually exclusive, you may only provide one of "
"them: %(fields)s"
msgstr ""
"Belirtilen alanlar birbirini dışlar; yalnızca birini sağlayabilirsiniz: "
"%(fields)s"

#: constraints.py:124
#, python-format
msgid ""
"The following fields are mutually inclusive, you must provide them all at "
"once or none of them: %(fields)s"
msgstr ""
"Belirtilen alanlar birlikte zorunludur; ya hepsini bir arada sağlamalısınız "
"ya da hiçbirini: %(fields)s"

#: constraints.py:160
#, python-format
msgid ""
"This query parameter also requires the following parameter to be present: "
"%(params)s"
msgid_plural ""
"This query parameter also requires the following parameters to be present: "
"%(params)s"
msgstr[0] ""
"Bu sorgu parametresi ayrıca şu parametrenin mevcut olmasını gerektirir: "
"%(params)s"
msgstr[1] ""
"Bu sorgu parametresi ayrıca şu parametrelerin mevcut olmasını gerektirir: "
"%(params)s"

#: fields.py:100
msgid "Enter a valid CSV value."
msgstr "Geçerli bir CSV değeri girin."

#: fields.py:129 fields.py:165
#, python-brace-format
msgid "{input} is not a valid choice, available choices are: {choices}"
msgstr "{input} geçerli bir seçenek değil, kullanılabilir seçenekler: {choices}"

#: filters.py:372
msgid "This query parameter does not allow specifying multiple values."
msgstr "Bu sorgu parametresi için birden fazla değer belirtilemez."

#: filtersets/base.py:512
msgid "This query parameter does not exist."
msgstr "Bu sorgu parametresi mevcut değil."

#: filtersets/base.py:516
#, python-format
msgid "This query parameter does not exist. Did you mean '%(param)s'?"
msgstr ""
"Bu sorgu parametresi mevcut değil. Muhtemelen '%(param)s' demek istediniz."

#: filtersets/base.py:524
#, python-format
msgid ""
"This query parameter does not exist. Did you mean one of these: "
"%(possibilities)s?"
msgstr ""
"Bu sorgu parametresi mevcut değil. Muhtemelen şunlardan birini demek "
"istediniz: %(possibilities)s."
